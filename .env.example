# Copy to .env in the project root, then restart Mochi.
# Secrets stay in Electron's main process. Never prefix them with VITE_.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional: published Agent Studio pipeline with a TTS (cascade) configuration.
AGORA_PIPELINE_ID=
# Default: Agora-managed Deepgram + OpenAI + MiniMax; no separate vendor keys.
AGORA_AREA=us
